# 复制 ktransformers 文件夹到 /workspace/
#COPY ktransformers /workspace/ktransformers

COPY ./ /workspace/ktransformers


# 如果 install.sh 在里面, 给执行权限并运行
RUN chmod +x /workspace/ktransformers/install.sh && \
    bash /workspace/ktransformers/install.sh

# 默认进入 bash
CMD ["/bin/bash"]
